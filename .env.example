# Google AdSense monetization.
# Set only after the verified publisher ID is confirmed for this deployed site.
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_EXCLUDED_PATHS=/login,/settings,/privacy,/terms,/api

# Interior backdata bridge (server-side only; never expose token as VITE_*).
# Keep empty until the current canonical Interior Core endpoint is verified.
# Do not reuse historical WebApp URLs that return 403 or have unresolved Script ownership.
INTERIOR_BACKDATA_ENDPOINT=
INTERIOR_BACKDATA_TOKEN=
